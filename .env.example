# LiveShop — environment variables (copy to .env and fill in)

# PostgreSQL connection string.
# For local dev you can start a bundled Postgres with: bun run postgres
DATABASE_URL="postgresql://liveshop:liveshop@localhost:5432/liveshop?schema=public"

# Secret used to sign JWT access tokens and hash OTP codes / refresh tokens.
# REQUIRED and must be ≥ 32 chars — the server refuses to start auth
# operations without it. Generate with: openssl rand -hex 32
AUTH_SECRET=""

# Optional — real SMS delivery via Kavenegar. When empty, dev (non-production)
# requests get the code printed to the server console and returned as devCode;
# in production an empty key fails closed with 502 OTP_DELIVERY_FAILED.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# Set to «true» ONLY when the app runs behind a reverse proxy that REWRITES
# (never appends) x-forwarded-for with the real client address — like the
# bundled Caddyfile does. Then x-forwarded-for is used for per-IP rate
# limiting. Otherwise it is ignored (spoofable) and the connection-level
# x-real-ip / "local" fallback is used instead.
TRUSTED_PROXY=
